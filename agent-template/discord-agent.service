# Template systemd unit for discord-agent. `bun run setup` substitutes the
# placeholders automatically; for the by-hand path see
# https://github.com/frolic/discord-agent/blob/main/docs/manual-setup.md.
#
# Placeholders (every doubled-brace marker below — fill in or let setup do it):
#   BOT_NAME    — friendly name shown in `systemctl status`
#   USER        — unix user the bot runs as
#   AGENT_HOME  — absolute path to the agent home directory
#   SOURCE_DIR  — absolute path to the discord-agent checkout
#   BUN_PATH    — absolute path to the bun binary (`which bun`)
#
# After substitution:
#   sudo cp <agent-home>/<bot>-discord-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now <bot>-discord-agent.service
#
# `StartLimitIntervalSec=0` disables systemd's restart rate limit. With
# the default (5 restarts in 10s) systemd marks the service failed and
# refuses to bring it back — a foot-gun if the agent self-restarts in
# quick succession (e.g., a tight self-edit loop).
#
# `Restart=always` restarts on any exit including clean `process.exit(0)`,
# which is what the agent calls when self-restarting.

[Unit]
Description=discord-agent ({{BOT_NAME}})
Documentation=https://github.com/frolic/discord-agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{AGENT_HOME}}
EnvironmentFile={{AGENT_HOME}}/.env
ExecStart={{BUN_PATH}} {{SOURCE_DIR}}/src/bin/agent.ts
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

# Hardening — kept minimal because the namespace-based directives
# (ProtectSystem=, ProtectHome=, PrivateTmp=) silently break on hosts
# where systemd can't set up mount namespaces (containers, some cloud
# VMs). Symptoms include /tmp becoming read-only and writes to the
# agent home failing despite ReadWritePaths. NoNewPrivileges is
# namespace-free and stable everywhere. To opt back into the stricter
# block via `systemctl edit` on hosts that support it, see
# https://github.com/frolic/discord-agent/blob/main/docs/operating.md#optional-stricter-hardening.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
